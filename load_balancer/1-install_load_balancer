#!/usr/bin/env bash
# Installs HAProxy on lb-01 with roundrobin load balancing across web-01 and web-02
apt-get update -y
apt-get install -y --no-install-recommends software-properties-common
add-apt-repository -y ppa:vbernat/haproxy-2.8 || true
apt-get update -y
apt-get install -y haproxy
sed -i "s/ENABLED=0/ENABLED=1/g" /etc/default/haproxy 2>/dev/null || true
printf "global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    balance roundrobin
    server 7113-web-01 13.40.85.82:80 check
    server 7113-web-02 35.179.127.188:80 check
" > /etc/haproxy/haproxy.cfg
service haproxy restart
