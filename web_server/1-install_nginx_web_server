#!/usr/bin/env bash
# Installs and configures Nginx on Ubuntu to serve Holberton School on port 80
apt-get update -y
apt-get install -y nginx

mkdir -p /var/www/html /usr/share/nginx/html
chmod -R 755 /var/www/html /usr/share/nginx/html
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Holberton School for the win!" > /usr/share/nginx/html/index.html
chmod 644 /var/www/html/index.html /usr/share/nginx/html/index.html

cat << 'NGINX_EOF' > /etc/nginx/sites-available/default
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }
}
NGINX_EOF

ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
nginx -t && (service nginx restart || /usr/sbin/nginx -s reload || /usr/sbin/nginx)
