#!/usr/bin/env bash
# Installs and configures Nginx on Ubuntu to serve Holberton School on port 80
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    SUDO="sudo"
fi

$SUDO apt-get update -y
$SUDO apt-get install -y nginx

$SUDO mkdir -p /var/www/html /usr/share/nginx/html
$SUDO chmod -R 755 /var/www/html /usr/share/nginx/html
echo "Holberton School for the win!" | $SUDO tee /var/www/html/index.html > /dev/null
echo "Holberton School for the win!" | $SUDO tee /usr/share/nginx/html/index.html > /dev/null
$SUDO chmod 644 /var/www/html/index.html /usr/share/nginx/html/index.html

$SUDO tee /etc/nginx/sites-available/default > /dev/null << 'NGINX_EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }
}
NGINX_EOF

$SUDO ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
$SUDO nginx -t && ($SUDO service nginx restart || $SUDO /etc/init.d/nginx restart || $SUDO /usr/sbin/nginx -s reload || $SUDO /usr/sbin/nginx)
