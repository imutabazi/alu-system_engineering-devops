#!/usr/bin/env bash
# Configures Nginx with a 301 redirect on /redirect_me and a custom 404 page containing Ceci n'est pas une page
apt-get update -y
apt-get install -y nginx

mkdir -p /var/www/html
chmod 755 /var/www/html
printf "Holberton School for the win!\n" > /var/www/html/index.html
printf "Ceci n'est pas une page\n" > /var/www/html/404.html
chmod 644 /var/www/html/index.html /var/www/html/404.html

cat << 'NGINX_EOF' > /etc/nginx/sites-available/default
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name _;

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }
}
NGINX_EOF

ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
service nginx restart || /etc/init.d/nginx restart || /usr/sbin/nginx
